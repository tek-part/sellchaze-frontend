{
  "name": "sellchase-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "api:install": "cd ../Sellchase-api && composer install",
    "dev:stack": "concurrently -k -n laravel,vite -c blue,magenta \"cd ../Sellchase-api && php artisan serve --host=127.0.0.1 --port=8000\" \"vite\"",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:strict": "eslint src/apps/storefront src/shared --max-warnings 0",
    "typecheck": "tsc -p tsconfig.storefront.json --noEmit",
    "typecheck:storefront": "tsc -p tsconfig.storefront.json --noEmit",
    "test": "vitest run",
    "pack:themes": "vite-node scripts/pack-themes.ts",
    "validate": "npm run lint && npm run lint:strict && npm run typecheck && npm run test",
    "ci": "npm run validate && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@react-oauth/google": "^0.13.4",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.38.0",
    "i18next": "^23.16.0",
    "laravel-echo": "^2.3.7",
    "pusher-js": "^8.5.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.1.0",
    "react-icons": "^5.3.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
