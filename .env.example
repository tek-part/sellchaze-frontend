# Copy to .env and adjust. Restart `npm run dev` after changes.
#
# Easiest local API: from Sellchase-api + Sellchase-react run `npm run dev:stack` (Laravel + Vite).

# Dev: leave unset to use same-origin /api/v1 (Vite proxies /api → Laravel; avoids CORS).
# Production / remote API (include /api/v1). Use https:// when the SPA is served over HTTPS (mixed content otherwise).
VITE_API_URL=https://sellchase-api.wigpleasure.com/api/v1
#
# Local Laravel directly (optional):
# VITE_API_URL=http://127.0.0.1:8000/api/v1

# Where Vite forwards /api (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional Google button (same Web client ID as Laravel GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=

# Wavex: Wawp API origin (hidden in UI; default https://api.wawp.net)
# VITE_WAWP_API_BASE_URL=https://api.wawp.net
