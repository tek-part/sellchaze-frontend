# Apache: Sellchase SPA (Vite build). Serves real files; all other routes → index.html for React Router.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Do not rewrite direct requests to index.html
    RewriteRule ^index\.html$ - [L]

    # Theme preview: any request carrying ?preview=1 must load the storefront app
    # (storefront.html), NOT the dashboard (index.html). This mirrors the dev-only
    # middleware in vite.config.js so theme previews render identically in
    # production. It is matched on the query string and placed before the
    # real-file/-directory check below, because the root "/" resolves to a
    # directory and would otherwise serve index.html first. The storefront's own
    # asset requests carry no preview flag, so they still fall through to real
    # files.
    RewriteCond %{QUERY_STRING} (^|&)preview=1(&|$)
    RewriteRule ^ storefront.html [L]

    # Existing files and directories (assets, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Client-side routes
    RewriteRule ^ index.html [L]
</IfModule>

# Long cache for hashed assets (Vite emits filenames with content hash)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Never cache the HTML entry points — they reference hashed assets that
    # change on each build. storefront.html and theme-studio.html are entries
    # too, so they must not be cached either or a preview could load stale JS.
    <FilesMatch "^(index|storefront|theme-studio)\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
